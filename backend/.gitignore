.vercel/

# Log de rollback da importacao de catalogo: gerado quando o cluster nao
# suporta transacao, para desfazer uma importacao interrompida.
.catalog-import/

# PDFs de catalogo de fornecedor (entrada) e fotos extraidas (saida) do
# extrator de imagens. Binarios grandes que nao pertencem ao git; quem roda o
# script coloca os PDFs em input/ e le o resultado em output/.
scripts/catalog-images/input/
scripts/catalog-images/output/

# Arte de banner e conteudo da loja, nao codigo: sao megabytes de PNG que
# mudam a cada campanha. O que versiona e o script; os arquivos ficam na
# maquina de quem sobe e no Cloudinary depois de subir.
scripts/banners/art/*
!scripts/banners/art/.gitkeep

logs/
*.log
npm-debug.log*

.DS_Store
