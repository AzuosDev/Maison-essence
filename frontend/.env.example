# URL da API, com o prefixo global. Sem barra no fim.
# Em desenvolvimento, o que `npm run start:dev` do backend sobe.
VITE_API_URL=http://localhost:3000/api/v1

# A mesma conta do Cloudinary que o backend usa. Aqui entra so o cloud name:
# ele aparece na URL de toda imagem publica e nao e segredo. A API key e a
# secret ficam no backend e nunca sobem para o navegador.
VITE_CLOUDINARY_CLOUD_NAME=
