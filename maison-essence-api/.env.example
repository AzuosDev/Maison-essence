# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta do servidor local (ignorada na Vercel)
PORT=3333

# Origens permitidas no CORS, separadas por virgula. Use * para liberar todas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Versao exposta em GET /api/v1/health.
# Localmente cai para a versao do package.json quando nao definida.
APP_VERSION=0.1.0

# String de conexao do MongoDB. No Atlas: Connect > Drivers.
# Troque <usuario> e <senha> pelas credenciais do usuario do banco.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco. Vem daqui e nao do caminho da URI: a string do Atlas nao traz
# banco nenhum e o Mongoose cairia no default "test".
MONGODB_DB_NAME=maison-essence


# Segredos dos tokens JWT. Gere um valor aleatorio distinto para cada um:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Trocar um segredo invalida na hora todos os tokens daquele tipo.
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-de-48-bytes
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-de-48-bytes


# ---------------------------------------------------------------------------
# Primeiro acesso ao painel. Nao existe cadastro aberto: alguem precisa criar
# o primeiro SUPER_ADMIN. As quatro variaveis abaixo servem so para isso e
# devem sair do ambiente depois — principalmente BOOTSTRAP_SECRET.
# ---------------------------------------------------------------------------

# E-mail e senha do primeiro usuario. A senha precisa de 12 caracteres ou mais
# e ja nasce com troca obrigatoria: ela esta em texto aqui e no painel da
# Vercel, entao serve para entrar uma vez.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Nome exibido no painel. Opcional.
BOOTSTRAP_SUPERADMIN_NAME=Super Admin

# Libera POST /api/v1/auth/bootstrap, que faz o mesmo que o comando
# `npm run seed:superadmin` para quem nao tem shell (a Vercel nao da uma).
# Minimo de 32 caracteres; gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# REMOVA esta variavel depois do primeiro acesso: sem ela a rota responde 404.
BOOTSTRAP_SECRET=
