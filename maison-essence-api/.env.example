# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta do servidor local (ignorada na Vercel)
PORT=3333

# Origens permitidas no CORS, separadas por virgula. Use * para liberar todas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Versao exposta em GET /api/v1/health.
# Localmente cai para a versao do package.json quando nao definida.
APP_VERSION=0.1.0
